{
  "name": "personal-tools",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'packages/*/src/**/*.test.ts'",
    "tasks:db:generate": "drizzle-kit generate --config src/modules/tasks/drizzle.config.ts",
    "tasks:db:migrate": "tsx src/modules/tasks/tools/migrate.ts",
    "tasks:skip-legacy-missed": "tsx src/modules/tasks/tools/skip-legacy-missed.ts",
    "finance:db:generate": "drizzle-kit generate --config src/modules/finance/drizzle.config.ts",
    "finance:db:migrate": "tsx src/modules/finance/tools/migrate.ts",
    "finance:import-v2": "tsx src/modules/finance/tools/import-v2.ts",
    "finance:fx-update": "tsx src/modules/finance/tools/fx-update.ts",
    "finance:import-statement": "tsx src/modules/finance/tools/import-statement.ts",
    "notify:test": "tsx src/platform/notify/test-cli.ts",
    "notify:tick": "tsx src/jobs/notify-cli.ts",
    "deploy": "bash deploy/macos/deploy.sh",
    "deploy:install": "bash deploy/macos/install.sh",
    "deploy:uninstall": "bash deploy/macos/uninstall.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
